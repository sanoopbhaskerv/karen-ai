GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DEMO_MODE=0
PORT=8080
# Set a long random value for stable browser sessions across restarts.
SECRET_KEY=
# On hosted deployments, set to a path on a persistent disk.
MEMORY_PATH=data/memory.txt
# Firmware build/upload selection only; changing this does not reflash a board.
# esp32 = original classic board; esp32_s3 = photographed HW678 / S3-N16R8 board.
KAREN_CONTROLLER=esp32
# Hosted HTTPS deployments only. Leave passwords/tokens empty for local use.
KAREN_ADMIN_USERNAME=karen
KAREN_ADMIN_PASSWORD=
KAREN_DEVICE_TOKEN=
KAREN_PUBLIC_UI=0
SESSION_COOKIE_SECURE=0
